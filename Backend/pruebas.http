# Solicita la lista completa de alumnos.
GET http://localhost:3000/alumnos

###
# Busca un alumno por su ID.
GET http://localhost:3000/alumnos/22

###
# Crea un alumno enviando los datos en formato JSON.
POST http://localhost:3000/alumnos
Content-Type: application/json

{
    "id": 3,
    "nombre": "Lucía",
    "carrera": "Programación"
}
###
# Actualiza el alumno cuyo ID aparece en la URL.
PUT http://localhost:3000/alumnos/2
Content-Type: application/json

{
    "id": 2,
    "nombre": "Juan Perez",
    "carrera": "Programación"
}

###
# Elimina el alumno indicado por el ID de la URL.
DELETE http://localhost:3000/alumnos/2

###
# Prueba la validación de campos obligatorios: falta el nombre.
POST http://localhost:3000/alumnos
Content-Type: application/json

{
    "id": 3,
    "carrera": "Programación"
}