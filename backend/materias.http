# 0. Login para obtener el token (esperado: 200)
# @name login
POST http://localhost:3000/auth/login
Content-Type: application/json

{
    "email": "admin@sga.com",
    "password": "ClaveDePrueba123!"
}

###
@token = {{login.response.body.token}}

# 1. Consultar todas las materias (esperado: 200)
GET http://localhost:3000/materias
Authorization: Bearer {{token}}

###
# 2a. Registrar varias: PRG1 (esperado: 201)
POST http://localhost:3000/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "PRG1",
    "nombre": "Programación I",
    "descripcion": "Fundamentos de algoritmos y programación estructurada",
    "cargaHoraria": 96,
    "estado": "activa"
}

###
# 2b. Registrar varias: PRG4 (esperado: 201)
POST http://localhost:3000/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "PRG4",
    "nombre": "Programación IV",
    "descripcion": "Desarrollo web con Node.js, Express, MongoDB y React",
    "cargaHoraria": 128,
    "estado": "activa"
}

###
# 2c. Registrar varias: LAB1 (esperado: 201)
POST http://localhost:3000/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "LAB1",
    "nombre": "Laboratorio I",
    "descripcion": "Prácticas de programación",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 3. Consultar por código (esperado: 200)
GET http://localhost:3000/materias/PRG4
Authorization: Bearer {{token}}

###
# 4. Consultar código inexistente (esperado: 404 "Materia no encontrada")
GET http://localhost:3000/materias/XYZ9
Authorization: Bearer {{token}}

###
# 5. Alta sin campos obligatorios (esperado: 400 "Todos los campos obligatorios")
POST http://localhost:3000/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "Sistemas Operativos",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 6. Alta con nombre que no es texto (esperado: 400 "El nombre debe ser un texto")
POST http://localhost:3000/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "SO1",
    "nombre": 123,
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 7. Alta con carga horaria que no es número (esperado: 400 "La carga horaria debe ser un número")
POST http://localhost:3000/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "SO1",
    "nombre": "Sistemas Operativos",
    "cargaHoraria": "64",
    "estado": "activa"
}

###
# 8. Alta con código duplicado (esperado: 400 "El código ya existe")
POST http://localhost:3000/materias
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "PRG1",
    "nombre": "Programación I bis",
    "cargaHoraria": 96,
    "estado": "activa"
}

###
# 9. Modificar nombre, descripción, carga horaria y estado (esperado: 200)
PUT http://localhost:3000/materias/LAB1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "Laboratorio de Programación I",
    "descripcion": "Prácticas guiadas de programación",
    "cargaHoraria": 96,
    "estado": "inactiva"
}

###
# 10. Intentar cambiar el código (esperado: 200, pero el código sigue siendo LAB1)
PUT http://localhost:3000/materias/LAB1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "codigo": "NUEVO1",
    "nombre": "Laboratorio de Programación I",
    "descripcion": "Prácticas guiadas de programación",
    "cargaHoraria": 96,
    "estado": "inactiva"
}

###
# 10b. Verificar que el código no cambió (esperado: 200 con codigo "LAB1")
GET http://localhost:3000/materias/LAB1
Authorization: Bearer {{token}}

###
# 10c. El código nuevo no existe (esperado: 404)
GET http://localhost:3000/materias/NUEVO1
Authorization: Bearer {{token}}

###
# 11. Modificar materia inexistente (esperado: 404)
PUT http://localhost:3000/materias/XYZ9
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "nombre": "Materia inexistente",
    "cargaHoraria": 64,
    "estado": "activa"
}

###
# 12a. Eliminar materia existente (esperado: 200)
DELETE http://localhost:3000/materias/LAB1
Authorization: Bearer {{token}}

###
# 12b. Volver a consultar la materia eliminada (esperado: 404)
GET http://localhost:3000/materias/LAB1
Authorization: Bearer {{token}}

###
# 13. Eliminar materia inexistente (esperado: 404)
DELETE http://localhost:3000/materias/XYZ9
Authorization: Bearer {{token}}
